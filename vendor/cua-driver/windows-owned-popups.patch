@@ -0,0 +1,83 @@
+//! Overlay policy for the exact driven Windows ownership family. No app names,
+//! menu classes or pixel assumptions; native adapters supply observed facts.
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum WinZOrderPlacement {
+    AboveTarget,
+    AboveTopmostTarget,
+    ForceFrontNonTopmost,
+}
+
+pub(super) fn win_z_order_placement(
+    has_live_target: bool,
+    target_topmost: bool,
+) -> WinZOrderPlacement {
+    if !has_live_target {
+        WinZOrderPlacement::ForceFrontNonTopmost
+    } else if target_topmost {
+        WinZOrderPlacement::AboveTopmostTarget
+    } else {
+        WinZOrderPlacement::AboveTarget
+    }
+}
+
+pub(super) fn is_driven_window_family(
+    window_id: u64,
+    root_owner: u64,
+    visible: bool,
+    roots: &[u64],
+) -> bool {
+    visible && (roots.contains(&window_id) || roots.contains(&root_owner))
+}
+
+pub(super) fn needs_z_order_maintenance(
+    painted: bool,
+    has_live_target: bool,
+    had_live_target: bool,
+) -> bool {
+    painted || has_live_target || had_live_target
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn demotes_after_the_resting_window_family_disappears() {
+        assert!(needs_z_order_maintenance(false, false, true));
+        assert!(!needs_z_order_maintenance(false, false, false));
+    }
+    #[test]
+    fn includes_owned_popup_and_nested_dialog_surfaces() {
+        assert!(is_driven_window_family(20, 10, true, &[10]));
+        assert!(is_driven_window_family(30, 10, true, &[10]));
+    }
+    #[test]
+    fn rejects_unrelated_main_windows_and_their_popups() {
+        assert!(!is_driven_window_family(40, 50, true, &[10]));
+        assert!(!is_driven_window_family(50, 50, true, &[10]));
+    }
+    #[test]
+    fn rejects_hidden_owned_windows() {
+        assert!(!is_driven_window_family(20, 10, false, &[10]));
+    }
+    #[test]
+    fn includes_each_live_driven_root() {
+        assert!(is_driven_window_family(10, 10, true, &[10, 50]));
+        assert!(is_driven_window_family(50, 50, true, &[10, 50]));
+    }
+    #[test]
+    fn returns_to_normal_band_when_the_topmost_popup_dismisses() {
+        assert_eq!(
+            win_z_order_placement(true, true),
+            WinZOrderPlacement::AboveTopmostTarget
+        );
+        assert_eq!(
+            win_z_order_placement(true, false),
+            WinZOrderPlacement::AboveTarget
+        );
+        assert_eq!(
+            win_z_order_placement(false, true),
+            WinZOrderPlacement::ForceFrontNonTopmost
+        );
+    }
+}
